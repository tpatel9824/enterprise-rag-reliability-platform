APP_ENV=development
AUTH_MODE=local
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
OIDC_CUSTOMER_CLAIM=customer_id
RAG_USE_GEMINI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GENAI_MODEL=
TOP_K=5
RETRIEVER_TYPE=tfidf
RETRIEVAL_STRATEGY=lexical
RAG_ARTIFACTS_DIR=artifacts
LEXICAL_ARTIFACTS_DIR=artifacts/v3/tfidf
DENSE_ARTIFACTS_DIR=artifacts/v3/dense
RETRIEVAL_CANDIDATE_K=20
RRF_CONSTANT=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_REVISION=
DENSE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LOCAL_IDENTITIES_PATH=data/identity/local_identities.json
ARTIFACT_STORAGE_MODE=local
GCS_ARTIFACT_BUCKET=
GCS_LEXICAL_PREFIX=indexes/v3/lexical
GCS_DENSE_PREFIX=indexes/v3/dense
ARTIFACT_CACHE_DIR=/tmp/acmeflow-artifacts
LOG_LEVEL=INFO
PORT=8080
